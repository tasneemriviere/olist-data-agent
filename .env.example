# Copier ce fichier en .env et remplir les valeurs
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=OLIST_SVC
SNOWFLAKE_ROLE=OLIST_PIPELINE
SNOWFLAKE_WAREHOUSE=OLIST_WH
SNOWFLAKE_DATABASE=OLIST
# Chemin absolu (dbt ne comprend pas ~)
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<toi>/.snowflake/rsa_key.p8
